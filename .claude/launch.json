{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && GG_DEBUG=true GG_DATABASE_URL=postgresql+asyncpg://grocery_genie:grocery_genie_dev@localhost:54440/grocery_genie GG_REDIS_URL=redis://localhost:54441/0 .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001"
      ],
      "port": 8001
    },
    {
      "name": "mobile-ios",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer EXPO_PUBLIC_API_URL=http://localhost:8001 CI=1 npx expo start --port 8081"
      ],
      "port": 8081
    }
  ]
}