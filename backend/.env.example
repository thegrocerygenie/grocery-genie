# Copy to backend/.env (git ignores it). The app, the extraction harness and
# `$G launch --live-llm` all read it.

# --- Redis from make db-up: the Celery broker and the API rate limit counts ---
GG_REDIS_URL=redis://localhost:54441/0

# --- LLM through the local LiteLLM proxy (make llm-up) ---
GG_LLM_PROVIDER=litellm_proxy
GG_LLM_MODEL=receipt-vision
GG_LLM_API_BASE=http://localhost:54442
# The proxy's LITELLM_MASTER_KEY from backend/llm-proxy/.env.
GG_LLM_API_KEY=

# --- Or call the provider directly: delete the four lines above and use ---
# GG_LLM_PROVIDER=anthropic
# GG_LLM_MODEL=claude-sonnet-5-5
# GG_LLM_API_KEY=<provider key>
