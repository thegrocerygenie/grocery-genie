#!/usr/bin/env bash
# Drive a throwaway Grocery Genie backend for verification. See ../SKILL.md.
#
#   gg-verify launch [--live-llm] [--stub-revenuecat]  start an isolated instance and wait
#                                   until usable; --stub-revenuecat points the REST API at a
#                                   local RevenueCat stand-in (scripts/revenuecat-stub.py)
#   gg-verify doctor                read-only: is this instance worth driving?
#   gg-verify signup [label] [--no-consent]  create a user; later api calls use its token.
#                                   It allows AI receipt reading, as the app's consent sheet
#                                   does; --no-consent leaves it off, so scans get 403.
#   gg-verify api METHOD PATH [JSON]  call the API as that user (body on stdout)
#   gg-verify scan [PHOTO]          upload a receipt photo (default: a generated one) to /api/receipts/scan
#   gg-verify download PATH         GET a file (an export) as that user into the evidence
#                                   directory; prints its path on stdout
#   gg-verify sql "SELECT ..."      read the instance's database
#   gg-verify revenuecat JSON [--secret VALUE]  POST a RevenueCat webhook body with the
#                                   launch's webhook secret (or VALUE, to prove a wrong one fails)
#   gg-verify premium               make the signed-in user Premium as RevenueCat would: a
#                                   yearly INITIAL_PURCHASE webhook, one year long
#   gg-verify waitlist import CSV | backfill | retry
#                                   the waitlist's ops commands (app.tasks.waitlist_tasks) against
#                                   this instance: load a Resend CSV export, match every account,
#                                   retry pending RevenueCat grants
#   gg-verify rcstub fail | ok | grants  make the RevenueCat stub refuse grants (503) or accept
#                                   them, or print the grants it received
#   gg-verify rcstub slow SECONDS | fast  delay each subscriber read by SECONDS, or stop
#   gg-verify cleanup               stop what launch started, drop its database
#   gg-verify last                  print the newest evidence directory
set -euo pipefail

REPO="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
BACKEND="$REPO/backend"
VENV="$BACKEND/.venv/bin"
ROOT="$REPO/.verification"
STATE="$ROOT/state"
PORT="${VERIFY_PORT:-8011}"
DB="${VERIFY_DB:-gg_verify}"
BASE="http://127.0.0.1:$PORT"
PG_CONTAINER="grocery_genie_db"
PG_USER="grocery_genie"
PG_URL_PREFIX="postgresql+asyncpg://grocery_genie:grocery_genie_dev@localhost:54440"
# Redis from make db-up (backend/docker-compose.yml maps 54441). DB 1 keeps
# this run's rate limit counts apart from the dev API on DB 0.
REDIS_URL="${VERIFY_REDIS_URL:-redis://localhost:54441/1}"

die() { echo "gg-verify: $*" >&2; exit 1; }
run_dir() { [ -f "$STATE/run_id" ] || die "no instance; run: gg-verify launch"; echo "$ROOT/runs/$(cat "$STATE/run_id")"; }
next_seq() {
  local n=$(( $(cat "$STATE/seq" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$STATE/seq"
  printf '%03d' "$n"
}
slug() { echo "$1" | sed -e 's#^/api/##' -e 's#[^A-Za-z0-9]#-#g' | cut -c1-60; }
psql_db() { local db="$1"; shift; docker exec -i "$PG_CONTAINER" psql -U "$PG_USER" -d "$db" -v ON_ERROR_STOP=1 -At "$@"; }
listener_pid() { lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 || true; }
code_fingerprint() {
  { git -C "$REPO" rev-parse HEAD; git -C "$REPO" diff HEAD -- backend; git -C "$REPO" ls-files --others --exclude-standard backend; } | shasum | cut -c1-12
}
guard_db() { [ "$DB" != "grocery_genie" ] && [ "$DB" != "postgres" ] || die "refusing to use database '$DB'; it belongs to the dev setup"; }

cmd_launch() {
  local mode="debug" stub=0 arg
  for arg in "$@"; do
    case "$arg" in
      --live-llm) mode="live-llm" ;;
      --stub-revenuecat) stub=1 ;;
      *) die "unknown launch flag: $arg" ;;
    esac
  done
  guard_db
  if [ -f "$STATE/pid" ]; then
    if kill -0 "$(cat "$STATE/pid")" 2>/dev/null; then
      die "an instance is already running (pid $(cat "$STATE/pid")). Run doctor, or cleanup first."
    fi
    die "stale state in $STATE from a crashed run; run: gg-verify cleanup"
  fi
  local other; other="$(listener_pid)"
  [ -z "$other" ] || die "port $PORT is in use by pid $other, which this skill did not start. Set VERIFY_PORT."
  [ -x "$VENV/uvicorn" ] || die "backend venv missing at $VENV (see 'Environment gotchas' in the latest .planning/HANDOFF-*.md)"
  if [ "$mode" = "live-llm" ] && [ -z "${GG_LLM_API_KEY:-}" ]; then
    die "--live-llm needs GG_LLM_API_KEY in the environment"
  fi

  local run_id; run_id="$(date +%Y%m%d-%H%M%S)"
  local run="$ROOT/runs/$run_id"
  mkdir -p "$STATE" "$run"
  echo "$run_id" > "$STATE/run_id"
  echo "$mode" > "$STATE/mode"
  echo 0 > "$STATE/seq"

  echo "== starting Postgres (shared container; never stopped by this skill)" >&2
  make -C "$REPO" db-up > "$run/db-up.log" 2>&1 || { cat "$run/db-up.log" >&2; die "make db-up failed"; }

  echo "== recreating database $DB" >&2
  psql_db postgres -c "DROP DATABASE IF EXISTS \"$DB\" WITH (FORCE)" > /dev/null
  psql_db postgres -c "CREATE DATABASE \"$DB\"" > /dev/null

  export GG_DATABASE_URL="$PG_URL_PREFIX/$DB"
  export GG_REDIS_URL="$REDIS_URL"
  export GG_DEBUG; GG_DEBUG="$([ "$mode" = "debug" ] && echo true || echo false)"
  export GG_JWT_SECRET; GG_JWT_SECRET="$(openssl rand -hex 32)"
  export GG_STORAGE_PATH="$STATE/uploads"
  # No email: --live-llm runs with GG_DEBUG=false, where startup needs a
  # Resend key unless email is turned off on purpose.
  export GG_RESEND_API_KEY="" GG_EMAIL_DELIVERY=off GG_EXPO_PUSH_ACCESS_TOKEN=""
  # Priority OCR (PREM-03): debug mode stubs the Premium extraction model as
  # "mock:<name>", so a journey sees which model read a scan. --live-llm keeps
  # the caller's GG_LLM_PREMIUM_EXTRACTION_MODEL (unset: Premium uses the default).
  if [ "$mode" = "debug" ]; then
    export GG_LLM_PREMIUM_EXTRACTION_MODEL="${GG_LLM_PREMIUM_EXTRACTION_MODEL:-verify/premium-model}"
  fi
  # Premium: a random webhook secret, kept in state (never in evidence), and
  # no REST API key, so nothing reaches RevenueCat.
  export GG_REVENUECAT_WEBHOOK_SECRET; GG_REVENUECAT_WEBHOOK_SECRET="$(openssl rand -hex 32)"
  export GG_REVENUECAT_API_KEY=""
  (umask 077; echo "$GG_REVENUECAT_WEBHOOK_SECRET" > "$STATE/revenuecat_secret")
  # The waitlist's free year (V11-P5): Premium launched a day ago, so the
  # claim window is open, and contacts created before launch qualify. With
  # no waitlist_entries (the default) nothing ever matches.
  export GG_PREMIUM_LAUNCHED_AT; GG_PREMIUM_LAUNCHED_AT="$(date -u -d '1 day ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-1d +%Y-%m-%dT%H:%M:%SZ)"
  export GG_WAITLIST_CUTOFF; GG_WAITLIST_CUTOFF="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  export GG_WAITLIST_EMAIL_HASH_SALT; GG_WAITLIST_EMAIL_HASH_SALT="$(openssl rand -hex 32)"
  export GG_RESEND_WAITLIST_AUDIENCE_ID=""
  if [ "$stub" = 1 ]; then
    # A local RevenueCat stand-in: grants and reads stay on this machine.
    local stub_port=$((PORT + 100)) stub_key; stub_key="sk_stub_$(openssl rand -hex 8)"
    [ -z "$(lsof -nP -iTCP:"$stub_port" -sTCP:LISTEN -t 2>/dev/null)" ] || die "port $stub_port (RevenueCat stub) is in use"
    nohup "$VENV/python" -I "$REPO/.agents/skills/verify-grocery-genie/scripts/revenuecat-stub.py" \
      "$stub_port" "$stub_key" "$run/revenuecat-stub.jsonl" "$STATE/revenuecat_fail" "$STATE/revenuecat_slow" \
      > "$run/revenuecat-stub.log" 2>&1 & echo $! > "$STATE/stub_pid"
    export GG_REVENUECAT_API_KEY="$stub_key"
    export GG_REVENUECAT_API_BASE="http://127.0.0.1:$stub_port"
    for i in $(seq 1 10); do
      [ -n "$(lsof -nP -iTCP:"$stub_port" -sTCP:LISTEN -t 2>/dev/null)" ] && break
      sleep 0.5
    done
  fi
  # The same settings for the waitlist ops commands (gg-verify waitlist ...).
  (umask 077; env | grep -E '^GG_' | sed "s/'/'\\\\''/g; s/=\(.*\)/='\1'/; s/^/export /" > "$STATE/env")

  echo "== migrating $DB to head" >&2
  (cd "$BACKEND" && "$VENV/alembic" upgrade head) > "$run/migrate.log" 2>&1 || { cat "$run/migrate.log" >&2; die "migration failed"; }

  echo "== starting uvicorn on $BASE (mode: $mode)" >&2
  (cd "$BACKEND" || exit 1; nohup "$VENV/uvicorn" main:app --host 127.0.0.1 --port "$PORT" > "$run/server.log" 2>&1 & echo $! > "$STATE/pid")
  local pid; pid="$(cat "$STATE/pid")"
  local i
  for i in $(seq 1 30); do
    kill -0 "$pid" 2>/dev/null || { tail -20 "$run/server.log" >&2; die "uvicorn exited during startup"; }
    curl -sf "$BASE/health" > /dev/null 2>&1 && break
    sleep 1
  done
  curl -sf "$BASE/health" > /dev/null || { tail -20 "$run/server.log" >&2; die "no answer on $BASE/health after 30s"; }

  # A Celery worker on this run's Redis DB, for tasks the API enqueues (the
  # waitlist claim link, V11-P5). No beat: scheduled tasks run only when a
  # journey asks (gg-verify waitlist ...). --purge drops a crashed run's queue.
  echo "== starting the Celery worker (log: worker.log)" >&2
  (cd "$BACKEND" || exit 1; nohup "$VENV/celery" -A app.tasks worker --pool=solo --purge \
    --loglevel=info --hostname "gg-verify-$PORT@%h" > "$run/worker.log" 2>&1 & echo $! > "$STATE/worker_pid")
  for i in $(seq 1 30); do
    grep -q " ready\." "$run/worker.log" 2>/dev/null && break
    kill -0 "$(cat "$STATE/worker_pid")" 2>/dev/null || { tail -20 "$run/worker.log" >&2; die "the Celery worker exited during startup"; }
    sleep 1
  done
  grep -q " ready\." "$run/worker.log" || { tail -20 "$run/worker.log" >&2; die "the Celery worker is not ready after 30s"; }

  # Ready means usable: a sign-up writes to the migrated database and the token authenticates.
  cmd_signup probe > /dev/null
  cmd_api GET /api/users/me > /dev/null || die "probe user could not read /api/users/me"
  rm -f "$STATE/token" "$STATE/email"

  {
    echo "run_id: $run_id"
    echo "mode: $mode"
    echo "revenuecat: $([ "$stub" = 1 ] && echo "stub at $GG_REVENUECAT_API_BASE" || echo "no API key")"
    echo "premium_extraction_model: ${GG_LLM_PREMIUM_EXTRACTION_MODEL:-unset}"
    echo "premium_launched_at: $GG_PREMIUM_LAUNCHED_AT"
    echo "waitlist_cutoff: $GG_WAITLIST_CUTOFF"
    echo "base_url: $BASE"
    echo "database: $DB"
    echo "pid: $pid"
    echo "worker_pid: $(cat "$STATE/worker_pid")"
    echo "git_head: $(git -C "$REPO" rev-parse --short HEAD)"
    echo "code_fingerprint: $(code_fingerprint)"
    echo "alembic: $(psql_db "$DB" -c 'SELECT version_num FROM alembic_version')"
  } | tee "$run/launch.txt" > "$STATE/launch.txt"
  echo "READY $BASE  evidence: $run" >&2
}

cmd_doctor() {
  local fail=0
  ok() { echo "OK   $*"; }
  bad() { echo "FAIL $*"; fail=1; }
  if [ ! -f "$STATE/pid" ]; then echo "FAIL no instance state in $STATE; run: gg-verify launch"; exit 1; fi
  local pid; pid="$(cat "$STATE/pid")"
  if kill -0 "$pid" 2>/dev/null; then ok "process $pid is alive"; else bad "process $pid is gone"; fi
  if [ "$(listener_pid)" = "$pid" ]; then ok "port $PORT is owned by pid $pid"; else bad "port $PORT is owned by '$(listener_pid)', not $pid"; fi
  if [ "$(curl -sf "$BASE/health" 2>/dev/null | jq -r .status 2>/dev/null)" = "ok" ]; then ok "GET /health answers ok"; else bad "GET /health does not answer ok"; fi
  local head current
  head="$(cd "$BACKEND" && "$VENV/alembic" heads 2>/dev/null | awk '{print $1}' | head -1)"
  current="$(psql_db "$DB" -c 'SELECT version_num FROM alembic_version' 2>/dev/null || true)"
  if [ -n "$head" ] && [ "$head" = "$current" ]; then ok "database $DB is at migration head $head"; else bad "database $DB is at '$current', head is '$head'"; fi
  local launched; launched="$(sed -n 's/^code_fingerprint: //p' "$STATE/launch.txt" 2>/dev/null)"
  if [ "$launched" = "$(code_fingerprint)" ]; then ok "backend code unchanged since launch"; else bad "backend code changed since launch; cleanup and launch again to drive the current code"; fi
  if [ -f "$STATE/worker_pid" ] && kill -0 "$(cat "$STATE/worker_pid")" 2>/dev/null; then ok "Celery worker $(cat "$STATE/worker_pid") is alive"; else bad "the Celery worker is gone (claim links will not be sent)"; fi
  if [ -f "$STATE/token" ]; then
    local code; code="$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(cat "$STATE/token")" "$BASE/api/users/me")"
    if [ "$code" = "200" ]; then ok "stored token authenticates ($(cat "$STATE/email"))"; else bad "stored token gets $code from /api/users/me; run signup again"; fi
  fi
  return "$fail"
}

cmd_signup() {
  local label="user" consent=1 arg
  for arg in "$@"; do
    case "$arg" in
      --no-consent) consent=0 ;;
      *) label="$arg" ;;
    esac
  done
  local run; run="$(run_dir)"
  local email; email="$label-$(cat "$STATE/run_id")-$RANDOM@example.com"
  local password; password="$(openssl rand -hex 16)"
  local seq; seq="$(next_seq)"
  local body code
  body="$(curl -s -w '\n%{http_code}' -H 'Content-Type: application/json' \
    -d "$(jq -n --arg e "$email" --arg p "$password" --arg n "$label" '{email:$e,password:$p,name:$n}')" \
    "$BASE/api/auth/sign-up")"
  code="$(echo "$body" | tail -1)"
  jq -n --arg e "$email" --arg s "$code" '{request:{method:"POST",path:"/api/auth/sign-up",email:$e},status:($s|tonumber)}' > "$run/$seq-POST-auth-sign-up.json"
  [ "$code" = "201" ] || die "sign-up returned $code: $(echo "$body" | sed '$d')"
  echo "$body" | sed '$d' | jq -r .access_token > "$STATE/token"
  echo "$email" > "$STATE/email"
  if [ "$consent" = 1 ]; then
    # The consent sheet's Allow (app/ai-consent.tsx): scans are refused without it.
    local version
    version="$(cmd_api GET /api/users/me 2>/dev/null | jq -r .ai_consent.current_policy_version)"
    [ -n "$version" ] && [ "$version" != null ] || die "could not read the consent policy version; see $run"
    cmd_api PUT /api/users/me/ai-consent "$(jq -nc --arg v "$version" '{policy_version:$v}')" > /dev/null 2>&1 \
      || die "allowing AI receipt reading failed; see $run"
  fi
  echo "$email"
}

cmd_api() {
  [ $# -ge 2 ] || die "usage: gg-verify api METHOD PATH [JSON]"
  local method="$1" path="$2" data="${3:-}" run; run="$(run_dir)"
  local seq; seq="$(next_seq)"
  local out="$run/$seq-$method-$(slug "$path").json"
  local args=(-s -w '\n%{http_code}' -X "$method")
  [ -f "$STATE/token" ] && args+=(-H "Authorization: Bearer $(cat "$STATE/token")")
  [ -n "$data" ] && args+=(-H 'Content-Type: application/json' -d "$data")
  local raw code body
  raw="$(curl "${args[@]}" "$BASE$path")"
  code="$(echo "$raw" | tail -1)"
  body="$(echo "$raw" | sed '$d')"
  jq -n --arg m "$method" --arg p "$path" --arg d "$data" --arg s "$code" --arg b "$body" \
    '{request:{method:$m,path:$p,body:($d|fromjson? // (if $d == "" then null else $d end))},status:($s|tonumber),response:($b|fromjson? // $b)}' > "$out"
  echo "$method $path -> $code" >&2
  [ -n "$body" ] && echo "$body"
  [ "$code" -lt 400 ]
}

# A binary or large body (the data export) does not fit the JSON evidence of
# `api`: save it raw next to a small JSON of the request, status and headers.
cmd_download() {
  [ $# -eq 1 ] || die "usage: gg-verify download PATH"
  local path="$1" run; run="$(run_dir)"
  [ -f "$STATE/token" ] || die "no user; run: gg-verify signup"
  local seq; seq="$(next_seq)"
  local base="$run/$seq-GET-$(slug "$path")"
  local code ctype disp
  code="$(curl -s -o "$base.body" -D "$base.headers" -w '%{http_code}' \
    -H "Authorization: Bearer $(cat "$STATE/token")" "$BASE$path")"
  ctype="$(grep -i '^content-type:' "$base.headers" | tail -1 | cut -d' ' -f2- | tr -d '\r' || true)"
  disp="$(grep -i '^content-disposition:' "$base.headers" | tail -1 | cut -d' ' -f2- | tr -d '\r' || true)"
  jq -n --arg p "$path" --arg s "$code" --arg t "$ctype" --arg d "$disp" --arg f "$(basename "$base.body")" \
    --argjson n "$(wc -c < "$base.body")" \
    '{request:{method:"GET",path:$p},status:($s|tonumber),content_type:$t,content_disposition:$d,bytes:$n,body_file:$f}' > "$base.json"
  rm -f "$base.headers"
  echo "GET $path -> $code ($ctype)" >&2
  echo "$base.body"
  [ "$code" -lt 400 ]
}

cmd_revenuecat() {
  [ $# -ge 1 ] || die "usage: gg-verify revenuecat JSON [--secret VALUE]"
  local data="$1" secret run; shift; run="$(run_dir)"
  secret="$(cat "$STATE/revenuecat_secret")"
  local label="launch secret"
  if [ "${1:-}" = "--secret" ]; then secret="${2:-}"; label="given secret"; fi
  local path=/api/webhooks/revenuecat seq; seq="$(next_seq)"
  local out="$run/$seq-POST-$(slug "$path").json"
  local raw code body
  raw="$(curl -s -w '\n%{http_code}' -X POST -H "Authorization: Bearer $secret" \
    -H 'Content-Type: application/json' -d "$data" "$BASE$path")"
  code="$(echo "$raw" | tail -1)"
  body="$(echo "$raw" | sed '$d')"
  jq -n --arg p "$path" --arg d "$data" --arg s "$code" --arg b "$body" --arg a "$label" \
    '{request:{method:"POST",path:$p,authorization:$a,body:($d|fromjson? // $d)},status:($s|tonumber),response:($b|fromjson? // $b)}' > "$out"
  echo "POST $path ($label) -> $code" >&2
  [ -n "$body" ] && echo "$body"
  [ "$code" -lt 400 ]
}

# Premium for the signed-in user, the way RevenueCat grants it (never a write
# to the database): for journeys that drive a Premium feature (comparison and
# mutes are Premium from D8). features/premium.md drives the webhook itself.
cmd_premium() {
  [ $# -eq 0 ] || die "usage: gg-verify premium"
  [ -f "$STATE/token" ] || die "no user; run: gg-verify signup"
  local uid now
  uid="$(cmd_api GET /api/users/me 2>/dev/null | jq -r .id)"
  [ -n "$uid" ] && [ "$uid" != null ] || die "could not read the signed-in user"
  now="$(date +%s)000"
  cmd_revenuecat "$(jq -nc --arg u "$uid" --argjson at "$now" '{api_version:"1.0",event:{id:("gg-verify-premium-"+$u),type:"INITIAL_PURCHASE",app_user_id:$u,aliases:[$u],entitlement_ids:["premium"],product_id:"gg_premium_yearly",period_type:"NORMAL",environment:"SANDBOX",event_timestamp_ms:$at,expiration_at_ms:($at+31536000000)}}')"
}

cmd_scan() {
  local run; run="$(run_dir)"
  [ -f "$STATE/token" ] || die "no user; run: gg-verify signup"
  local img="$STATE/receipt.jpg" type="image/jpeg" label="generated 400x600 JPEG"
  if [ -n "${1:-}" ]; then
    [ -f "$1" ] || die "no such photo: $1"
    img="$1"; label="$(basename "$1")"
    case "$(echo "$1" | tr '[:upper:]' '[:lower:]')" in
      *.png) type="image/png" ;; *.heic) type="image/heic" ;; *.pdf) type="application/pdf" ;;
    esac
  else
  # Same recipe as backend/tests/conftest.py test_image_bytes: textured, so it passes blur detection.
  "$VENV/python" - "$img" <<'PY'
import random, sys
from PIL import Image
random.seed(42)
img = Image.new("RGB", (400, 600), color=(240, 240, 240))
px = img.load()
for x in range(0, 400, 2):
    for y in range(0, 600, 2):
        v = random.randint(100, 200)
        px[x, y] = (v, v, v)
img.save(sys.argv[1], format="JPEG")
PY
  fi
  local seq; seq="$(next_seq)"
  local raw code body
  raw="$(curl -s -w '\n%{http_code}' -H "Authorization: Bearer $(cat "$STATE/token")" \
    -F "file=@$img;type=$type" "$BASE/api/receipts/scan")"
  code="$(echo "$raw" | tail -1)"
  body="$(echo "$raw" | sed '$d')"
  jq -n --arg s "$code" --arg b "$body" --arg f "$label" '{request:{method:"POST",path:"/api/receipts/scan",file:$f},status:($s|tonumber),response:($b|fromjson? // $b)}' > "$run/$seq-POST-receipts-scan.json"
  echo "POST /api/receipts/scan -> $code" >&2
  echo "$body"
  [ "$code" -lt 400 ]
}

cmd_sql() {
  [ $# -eq 1 ] || die "usage: gg-verify sql \"SELECT ...\""
  local run; run="$(run_dir)"
  local seq; seq="$(next_seq)"
  local result; result="$(psql_db "$DB" -c "$1")"
  printf -- '-- %s\n%s\n' "$1" "$result" > "$run/$seq-sql.txt"
  echo "$result"
}

# The waitlist's ops commands (docs/DEPLOYMENT.md 2.10), run as an operator
# would, with this instance's settings: the real path for loading the waitlist,
# so no journey writes rows through sql.
cmd_waitlist() {
  [ $# -ge 1 ] || die "usage: gg-verify waitlist import CSV | backfill | retry"
  local run; run="$(run_dir)"
  [ -f "$STATE/env" ] || die "no instance settings in $STATE/env; launch again"
  local args=()
  case "$1" in
    import) [ -f "${2:-}" ] || die "usage: gg-verify waitlist import CSV"; args=(import-csv "$(cd "$(dirname "$2")" && pwd)/$(basename "$2")") ;;
    backfill) args=(backfill) ;;
    # The beat retry waits 5 minutes after an attempt; here, retry at once.
    retry) args=(retry --older-than-minutes 0) ;;
    *) die "usage: gg-verify waitlist import CSV | backfill | retry" ;;
  esac
  local seq; seq="$(next_seq)"
  local out="$run/$seq-waitlist-$1.txt" status=0
  # shellcheck disable=SC1091
  (source "$STATE/env"; cd "$BACKEND" && "$VENV/python" -m app.tasks.waitlist_tasks "${args[@]}") > "$out" 2>&1 || status=$?
  [ "$1" = import ] && printf -- '-- import file: %s\n%s\n' "$(basename "$2")" "$(cat "$2")" >> "$out"
  echo "waitlist $1 -> exit $status" >&2
  grep -E '^waitlist ' "$out" || true
  return "$status"
}

cmd_rcstub() {
  local run; run="$(run_dir)"
  [ -f "$STATE/stub_pid" ] || die "no RevenueCat stub; launch with --stub-revenuecat"
  case "${1:-}" in
    fail) touch "$STATE/revenuecat_fail"; echo "RevenueCat stub: grants answer 503" >&2 ;;
    ok) rm -f "$STATE/revenuecat_fail"; echo "RevenueCat stub: grants accepted" >&2 ;;
    grants) cat "$run/revenuecat-stub.jsonl" 2>/dev/null || true ;;
    slow)
      [[ "${2:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "usage: gg-verify rcstub slow SECONDS"
      echo "$2" > "$STATE/revenuecat_slow"; echo "RevenueCat stub: subscriber reads wait ${2}s" >&2 ;;
    fast) rm -f "$STATE/revenuecat_slow"; echo "RevenueCat stub: subscriber reads answer at once" >&2 ;;
    *) die "usage: gg-verify rcstub fail | ok | grants | slow SECONDS | fast" ;;
  esac
}

cmd_cleanup() {
  guard_db
  local run=""
  [ -f "$STATE/run_id" ] && run="$ROOT/runs/$(cat "$STATE/run_id")"
  if [ -f "$STATE/worker_pid" ]; then
    local wpid; wpid="$(cat "$STATE/worker_pid")"
    if kill -0 "$wpid" 2>/dev/null && ps -p "$wpid" -o command= | grep -q "gg-verify-$PORT@"; then
      kill "$wpid"
      local j; for j in $(seq 1 10); do kill -0 "$wpid" 2>/dev/null || break; sleep 1; done
      kill -0 "$wpid" 2>/dev/null && kill -9 "$wpid"
      echo "stopped Celery worker pid $wpid" >&2
    fi
  fi
  if [ -f "$STATE/stub_pid" ]; then
    local spid; spid="$(cat "$STATE/stub_pid")"
    if kill -0 "$spid" 2>/dev/null && ps -p "$spid" -o command= | grep -q "revenuecat-stub.py"; then
      kill "$spid" && echo "stopped RevenueCat stub pid $spid" >&2
    fi
  fi
  if [ -f "$STATE/pid" ]; then
    local pid; pid="$(cat "$STATE/pid")"
    if kill -0 "$pid" 2>/dev/null; then
      if ps -p "$pid" -o command= | grep -q "uvicorn main:app --host 127.0.0.1 --port $PORT"; then
        kill "$pid"
        local i; for i in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
        echo "stopped pid $pid" >&2
      else
        echo "pid $pid is not the uvicorn this skill started; left running" >&2
      fi
    fi
  fi
  if docker exec "$PG_CONTAINER" true 2>/dev/null; then
    psql_db postgres -c "DROP DATABASE IF EXISTS \"$DB\" WITH (FORCE)" > /dev/null
    echo "dropped database $DB" >&2
  fi
  [ -n "$run" ] && [ -d "$run" ] && date '+cleaned up: %Y-%m-%dT%H:%M:%S%z' > "$run/cleanup.txt"
  rm -rf "$STATE"
  [ -n "$run" ] && echo "evidence kept at $run" >&2
  return 0
}

cmd_last() { ls -1d "$ROOT"/runs/* 2>/dev/null | tail -1; }

case "${1:-}" in
  launch|doctor|signup|api|download|scan|sql|revenuecat|premium|waitlist|rcstub|cleanup|last) sub="$1"; shift; "cmd_$sub" "$@" ;;
  *) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
