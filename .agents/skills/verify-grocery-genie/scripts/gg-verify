#!/usr/bin/env bash
# Drive a throwaway Grocery Genie backend for verification. See ../SKILL.md.
#
#   gg-verify launch [--live-llm]   start an isolated instance and wait until usable
#   gg-verify doctor                read-only: is this instance worth driving?
#   gg-verify signup [label]        create a user; later api calls use its token
#   gg-verify api METHOD PATH [JSON]  call the API as that user (body on stdout)
#   gg-verify scan [PHOTO]          upload a receipt photo (default: a generated one) to /api/receipts/scan
#   gg-verify sql "SELECT ..."      read the instance's database
#   gg-verify cleanup               stop what launch started, drop its database
#   gg-verify last                  print the newest evidence directory
set -euo pipefail

REPO="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
BACKEND="$REPO/backend"
VENV="$BACKEND/.venv/bin"
ROOT="$REPO/.verification"
STATE="$ROOT/state"
PORT="${VERIFY_PORT:-8011}"
DB="${VERIFY_DB:-gg_verify}"
BASE="http://127.0.0.1:$PORT"
PG_CONTAINER="grocery_genie_db"
PG_USER="grocery_genie"
PG_URL_PREFIX="postgresql+asyncpg://grocery_genie:grocery_genie_dev@localhost:54440"

die() { echo "gg-verify: $*" >&2; exit 1; }
run_dir() { [ -f "$STATE/run_id" ] || die "no instance; run: gg-verify launch"; echo "$ROOT/runs/$(cat "$STATE/run_id")"; }
next_seq() {
  local n=$(( $(cat "$STATE/seq" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$STATE/seq"
  printf '%03d' "$n"
}
slug() { echo "$1" | sed -e 's#^/api/##' -e 's#[^A-Za-z0-9]#-#g' | cut -c1-60; }
psql_db() { local db="$1"; shift; docker exec -i "$PG_CONTAINER" psql -U "$PG_USER" -d "$db" -v ON_ERROR_STOP=1 -At "$@"; }
listener_pid() { lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 || true; }
code_fingerprint() {
  { git -C "$REPO" rev-parse HEAD; git -C "$REPO" diff HEAD -- backend; git -C "$REPO" ls-files --others --exclude-standard backend; } | shasum | cut -c1-12
}
guard_db() { [ "$DB" != "grocery_genie" ] && [ "$DB" != "postgres" ] || die "refusing to use database '$DB'; it belongs to the dev setup"; }

cmd_launch() {
  local mode="debug"
  [ "${1:-}" = "--live-llm" ] && mode="live-llm"
  guard_db
  if [ -f "$STATE/pid" ]; then
    if kill -0 "$(cat "$STATE/pid")" 2>/dev/null; then
      die "an instance is already running (pid $(cat "$STATE/pid")). Run doctor, or cleanup first."
    fi
    die "stale state in $STATE from a crashed run; run: gg-verify cleanup"
  fi
  local other; other="$(listener_pid)"
  [ -z "$other" ] || die "port $PORT is in use by pid $other, which this skill did not start. Set VERIFY_PORT."
  [ -x "$VENV/uvicorn" ] || die "backend venv missing at $VENV (see 'Environment gotchas' in the latest .planning/HANDOFF-*.md)"
  if [ "$mode" = "live-llm" ] && [ -z "${GG_LLM_API_KEY:-}" ]; then
    die "--live-llm needs GG_LLM_API_KEY in the environment"
  fi

  local run_id; run_id="$(date +%Y%m%d-%H%M%S)"
  local run="$ROOT/runs/$run_id"
  mkdir -p "$STATE" "$run"
  echo "$run_id" > "$STATE/run_id"
  echo "$mode" > "$STATE/mode"
  echo 0 > "$STATE/seq"

  echo "== starting Postgres (shared container; never stopped by this skill)" >&2
  make -C "$REPO" db-up > "$run/db-up.log" 2>&1 || { cat "$run/db-up.log" >&2; die "make db-up failed"; }

  echo "== recreating database $DB" >&2
  psql_db postgres -c "DROP DATABASE IF EXISTS \"$DB\" WITH (FORCE)" > /dev/null
  psql_db postgres -c "CREATE DATABASE \"$DB\"" > /dev/null

  export GG_DATABASE_URL="$PG_URL_PREFIX/$DB"
  export GG_DEBUG; GG_DEBUG="$([ "$mode" = "debug" ] && echo true || echo false)"
  export GG_JWT_SECRET; GG_JWT_SECRET="$(openssl rand -hex 32)"
  export GG_STORAGE_PATH="$STATE/uploads"
  # No email: --live-llm runs with GG_DEBUG=false, where startup needs a
  # Resend key unless email is turned off on purpose.
  export GG_RESEND_API_KEY="" GG_EMAIL_DELIVERY=off GG_EXPO_PUSH_ACCESS_TOKEN=""

  echo "== migrating $DB to head" >&2
  (cd "$BACKEND" && "$VENV/alembic" upgrade head) > "$run/migrate.log" 2>&1 || { cat "$run/migrate.log" >&2; die "migration failed"; }

  echo "== starting uvicorn on $BASE (mode: $mode)" >&2
  (cd "$BACKEND" || exit 1; nohup "$VENV/uvicorn" main:app --host 127.0.0.1 --port "$PORT" > "$run/server.log" 2>&1 & echo $! > "$STATE/pid")
  local pid; pid="$(cat "$STATE/pid")"
  local i
  for i in $(seq 1 30); do
    kill -0 "$pid" 2>/dev/null || { tail -20 "$run/server.log" >&2; die "uvicorn exited during startup"; }
    curl -sf "$BASE/health" > /dev/null 2>&1 && break
    sleep 1
  done
  curl -sf "$BASE/health" > /dev/null || { tail -20 "$run/server.log" >&2; die "no answer on $BASE/health after 30s"; }

  # Ready means usable: a sign-up writes to the migrated database and the token authenticates.
  cmd_signup probe > /dev/null
  cmd_api GET /api/users/me > /dev/null || die "probe user could not read /api/users/me"
  rm -f "$STATE/token" "$STATE/email"

  {
    echo "run_id: $run_id"
    echo "mode: $mode"
    echo "base_url: $BASE"
    echo "database: $DB"
    echo "pid: $pid"
    echo "git_head: $(git -C "$REPO" rev-parse --short HEAD)"
    echo "code_fingerprint: $(code_fingerprint)"
    echo "alembic: $(psql_db "$DB" -c 'SELECT version_num FROM alembic_version')"
  } | tee "$run/launch.txt" > "$STATE/launch.txt"
  echo "READY $BASE  evidence: $run" >&2
}

cmd_doctor() {
  local fail=0
  ok() { echo "OK   $*"; }
  bad() { echo "FAIL $*"; fail=1; }
  if [ ! -f "$STATE/pid" ]; then echo "FAIL no instance state in $STATE; run: gg-verify launch"; exit 1; fi
  local pid; pid="$(cat "$STATE/pid")"
  if kill -0 "$pid" 2>/dev/null; then ok "process $pid is alive"; else bad "process $pid is gone"; fi
  if [ "$(listener_pid)" = "$pid" ]; then ok "port $PORT is owned by pid $pid"; else bad "port $PORT is owned by '$(listener_pid)', not $pid"; fi
  if [ "$(curl -sf "$BASE/health" 2>/dev/null | jq -r .status 2>/dev/null)" = "ok" ]; then ok "GET /health answers ok"; else bad "GET /health does not answer ok"; fi
  local head current
  head="$(cd "$BACKEND" && "$VENV/alembic" heads 2>/dev/null | awk '{print $1}' | head -1)"
  current="$(psql_db "$DB" -c 'SELECT version_num FROM alembic_version' 2>/dev/null || true)"
  if [ -n "$head" ] && [ "$head" = "$current" ]; then ok "database $DB is at migration head $head"; else bad "database $DB is at '$current', head is '$head'"; fi
  local launched; launched="$(sed -n 's/^code_fingerprint: //p' "$STATE/launch.txt" 2>/dev/null)"
  if [ "$launched" = "$(code_fingerprint)" ]; then ok "backend code unchanged since launch"; else bad "backend code changed since launch; cleanup and launch again to drive the current code"; fi
  if [ -f "$STATE/token" ]; then
    local code; code="$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(cat "$STATE/token")" "$BASE/api/users/me")"
    if [ "$code" = "200" ]; then ok "stored token authenticates ($(cat "$STATE/email"))"; else bad "stored token gets $code from /api/users/me; run signup again"; fi
  fi
  return "$fail"
}

cmd_signup() {
  local label="${1:-user}" run; run="$(run_dir)"
  local email; email="$label-$(cat "$STATE/run_id")-$RANDOM@example.com"
  local password; password="$(openssl rand -hex 16)"
  local seq; seq="$(next_seq)"
  local body code
  body="$(curl -s -w '\n%{http_code}' -H 'Content-Type: application/json' \
    -d "$(jq -n --arg e "$email" --arg p "$password" --arg n "$label" '{email:$e,password:$p,name:$n}')" \
    "$BASE/api/auth/sign-up")"
  code="$(echo "$body" | tail -1)"
  jq -n --arg e "$email" --arg s "$code" '{request:{method:"POST",path:"/api/auth/sign-up",email:$e},status:($s|tonumber)}' > "$run/$seq-POST-auth-sign-up.json"
  [ "$code" = "201" ] || die "sign-up returned $code: $(echo "$body" | sed '$d')"
  echo "$body" | sed '$d' | jq -r .access_token > "$STATE/token"
  echo "$email" > "$STATE/email"
  echo "$email"
}

cmd_api() {
  [ $# -ge 2 ] || die "usage: gg-verify api METHOD PATH [JSON]"
  local method="$1" path="$2" data="${3:-}" run; run="$(run_dir)"
  local seq; seq="$(next_seq)"
  local out="$run/$seq-$method-$(slug "$path").json"
  local args=(-s -w '\n%{http_code}' -X "$method")
  [ -f "$STATE/token" ] && args+=(-H "Authorization: Bearer $(cat "$STATE/token")")
  [ -n "$data" ] && args+=(-H 'Content-Type: application/json' -d "$data")
  local raw code body
  raw="$(curl "${args[@]}" "$BASE$path")"
  code="$(echo "$raw" | tail -1)"
  body="$(echo "$raw" | sed '$d')"
  jq -n --arg m "$method" --arg p "$path" --arg d "$data" --arg s "$code" --arg b "$body" \
    '{request:{method:$m,path:$p,body:($d|fromjson? // (if $d == "" then null else $d end))},status:($s|tonumber),response:($b|fromjson? // $b)}' > "$out"
  echo "$method $path -> $code" >&2
  [ -n "$body" ] && echo "$body"
  [ "$code" -lt 400 ]
}

cmd_scan() {
  local run; run="$(run_dir)"
  [ -f "$STATE/token" ] || die "no user; run: gg-verify signup"
  local img="$STATE/receipt.jpg" type="image/jpeg" label="generated 400x600 JPEG"
  if [ -n "${1:-}" ]; then
    [ -f "$1" ] || die "no such photo: $1"
    img="$1"; label="$(basename "$1")"
    case "$(echo "$1" | tr '[:upper:]' '[:lower:]')" in
      *.png) type="image/png" ;; *.heic) type="image/heic" ;; *.pdf) type="application/pdf" ;;
    esac
  else
  # Same recipe as backend/tests/conftest.py test_image_bytes: textured, so it passes blur detection.
  "$VENV/python" - "$img" <<'PY'
import random, sys
from PIL import Image
random.seed(42)
img = Image.new("RGB", (400, 600), color=(240, 240, 240))
px = img.load()
for x in range(0, 400, 2):
    for y in range(0, 600, 2):
        v = random.randint(100, 200)
        px[x, y] = (v, v, v)
img.save(sys.argv[1], format="JPEG")
PY
  fi
  local seq; seq="$(next_seq)"
  local raw code body
  raw="$(curl -s -w '\n%{http_code}' -H "Authorization: Bearer $(cat "$STATE/token")" \
    -F "file=@$img;type=$type" "$BASE/api/receipts/scan")"
  code="$(echo "$raw" | tail -1)"
  body="$(echo "$raw" | sed '$d')"
  jq -n --arg s "$code" --arg b "$body" --arg f "$label" '{request:{method:"POST",path:"/api/receipts/scan",file:$f},status:($s|tonumber),response:($b|fromjson? // $b)}' > "$run/$seq-POST-receipts-scan.json"
  echo "POST /api/receipts/scan -> $code" >&2
  echo "$body"
  [ "$code" -lt 400 ]
}

cmd_sql() {
  [ $# -eq 1 ] || die "usage: gg-verify sql \"SELECT ...\""
  local run; run="$(run_dir)"
  local seq; seq="$(next_seq)"
  local result; result="$(psql_db "$DB" -c "$1")"
  printf -- '-- %s\n%s\n' "$1" "$result" > "$run/$seq-sql.txt"
  echo "$result"
}

cmd_cleanup() {
  guard_db
  local run=""
  [ -f "$STATE/run_id" ] && run="$ROOT/runs/$(cat "$STATE/run_id")"
  if [ -f "$STATE/pid" ]; then
    local pid; pid="$(cat "$STATE/pid")"
    if kill -0 "$pid" 2>/dev/null; then
      if ps -p "$pid" -o command= | grep -q "uvicorn main:app --host 127.0.0.1 --port $PORT"; then
        kill "$pid"
        local i; for i in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
        echo "stopped pid $pid" >&2
      else
        echo "pid $pid is not the uvicorn this skill started; left running" >&2
      fi
    fi
  fi
  if docker exec "$PG_CONTAINER" true 2>/dev/null; then
    psql_db postgres -c "DROP DATABASE IF EXISTS \"$DB\" WITH (FORCE)" > /dev/null
    echo "dropped database $DB" >&2
  fi
  [ -n "$run" ] && [ -d "$run" ] && date '+cleaned up: %Y-%m-%dT%H:%M:%S%z' > "$run/cleanup.txt"
  rm -rf "$STATE"
  [ -n "$run" ] && echo "evidence kept at $run" >&2
  return 0
}

cmd_last() { ls -1d "$ROOT"/runs/* 2>/dev/null | tail -1; }

case "${1:-}" in
  launch|doctor|signup|api|scan|sql|cleanup|last) sub="$1"; shift; "cmd_$sub" "$@" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
