# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend audience (waitlist) — https://resend.com/audiences
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Optional: send a welcome email when someone joins.
# Leave WAITLIST_FROM blank to skip the welcome send.
# Must be a verified Resend sending address (https://resend.com/domains).
# WAITLIST_FROM=Grocery Genie <hello@grocerygenie.app>
# WAITLIST_WELCOME_SUBJECT=You're on the Grocery Genie list
# WAITLIST_WELCOME_TEXT=Custom welcome copy. Leave unset to use the default.
# A custom text must keep the line saying the free Premium year goes to the app
# account with the same email (privacy text, docs/launch-open-items.md §6).

# Optional: lock CORS to your production origin (defaults to *)
# ALLOWED_ORIGIN=https://grocerygenie.app

# Local dev only
PORT=3000

# ---- Site build (Astro). PUBLIC_* values are baked into the page at build time. ----
# Launch state: "a" = pre-launch (waitlist form), "b" = launch (App Store badge, QR code, smart banner)
PUBLIC_LAUNCH_STATE=a
# Real App Store ID once the listing exists (badge link, QR code, apple-itunes-app banner)
PUBLIC_APP_STORE_ID=0000000000
# Optional: post the form somewhere other than this site's /api/waitlist
# PUBLIC_WAITLIST_ENDPOINT=
