{
  "name": "grocery-genie-marketing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Grocery Genie marketing site — Astro (static output) with React islands and a Resend-backed waitlist API.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node server.js",
    "check": "astro check",
    "build:icons": "node scripts/render-icons.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:pages": "node tests/page.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/legal-pages.mjs",
    "test": "npm run test:smoke && npm run build && npm run test:pages"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "astro": "^7.4.5",
    "lucide-static": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
