{
  "expo": {
    "name": "Grocery Genie",
    "slug": "grocery-genie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "scheme": "grocerygenie",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.grocerygenie.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Grocery Genie uses the camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Grocery Genie accesses your photo library to import receipt images."
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "redirects": [
            {
              "source": "/notification-settings",
              "destination": "/settings/notification-settings",
              "permanent": true
            },
            {
              "source": "/language-settings",
              "destination": "/settings/language-settings",
              "permanent": true
            }
          ]
        }
      ],
      "expo-camera",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-notifications",
      "./plugins/withPodsMinDeploymentTarget",
      "./plugins/ios-scene-lifecycle"
    ]
  }
}
