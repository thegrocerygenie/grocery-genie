{
  "expo": {
    "name": "Grocery Genie",
    "slug": "grocery-genie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-light.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "scheme": "grocerygenie",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.grocerygenie.app",
      "icon": {
        "light": "./assets/brand/app-icon-light.png",
        "dark": "./assets/brand/app-icon-dark.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Grocery Genie uses the camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Grocery Genie accesses your photo library to import receipt images."
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "redirects": [
            {
              "source": "/notification-settings",
              "destination": "/settings/notification-settings",
              "permanent": true
            },
            {
              "source": "/language-settings",
              "destination": "/settings/language-settings",
              "permanent": true
            }
          ]
        }
      ],
      "expo-camera",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-mark-light.png",
          "imageWidth": 120,
          "backgroundColor": "#FBF8F1",
          "dark": {
            "image": "./assets/brand/logo-mark-dark.png",
            "backgroundColor": "#1B1A15"
          }
        }
      ],
      "./plugins/withPodsMinDeploymentTarget",
      "./plugins/withDocumentScannerNoLocation",
      "./plugins/ios-scene-lifecycle",
      "./plugins/withUserScriptSandboxingOff"
    ]
  }
}
