# Copy to mobile/.env.local (git ignores it). Expo reads env files only from
# mobile/, before it evaluates app.config.ts and bundles the app.
#
# Every EXPO_PUBLIC_ value is baked into the JS bundle, so anyone with the app
# can read it. Never put a secret here. For EAS cloud builds, set the same keys
# as EAS environment variables (`eas env:create`): .env.local isn't uploaded.

# --- Backend API ---
# make backend-dev serves on 8001. On a phone, or Expo Go over the LAN, use the
# Mac's LAN address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8001

# --- Sign in with Google (Google Cloud console, OAuth client IDs) ---
# The iOS client ID. app.config.ts adds Google's URL scheme from it, and the
# app hides "Continue with Google" while it's unset.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The web client ID: Google's ID tokens carry it as their audience. It must
# equal the backend's GG_GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
